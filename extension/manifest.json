{
  "manifest_version": 3,
  "name": "属性对比台",
  "version": "0.3.0",
  "author" : "Evelynn",
  "description": "对比 target 与 source 的属性：高亮相同属性与重复属性值，并提取到结果框",
  "icons": {
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "打开属性对比台",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
